# WiFi setup page local web server - systemd --user service.
#
# Installed at ~/.config/systemd/user/wifi-setup-server.service on the Pi
# (user "admin", uid 1000), alongside kiosk.service and
# kiosk-watchdog.service. See wifi-setup-server.py's own top comment for
# the full "why".
#
# Deliberately always running (not started/stopped on entering/leaving
# hotspot mode) - it's a trivial, idle, loopback-only static file server
# when nothing's requesting it, and always-on means kiosk-wrapper.sh can
# point Chromium at it the instant it decides to, with no startup race to
# coordinate. Independent of kiosk.service/kiosk-watchdog.service, same
# "a restart of one must never take the others down" reasoning
# kiosk-watchdog.service's own comment already established.

[Unit]
Description=WiFi setup page local web server
After=default.target

[Service]
ExecStart=/usr/bin/python3 /home/admin/.config/systemd/user/wifi-setup-server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
