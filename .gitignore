# Local-only secrets for `wrangler pages dev` (AUTH_SECRET etc.) - never commit.
.dev.vars
.dev.vars.*

# Wrangler local state/cache
.wrangler/

# Regenerated by scripts/generate-pilot-version.mjs on every
# `npm run dev`/`npm run build` (see package.json) - always freshly
# written before Vite ever tries to resolve it, so there's no fallback
# value worth committing; committing one would just go stale and cause
# noisy diffs every real deploy for no benefit.
src/generated/
